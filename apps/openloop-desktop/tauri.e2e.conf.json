{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "ai.openloop.desktop.e2e",
  "build": {
    "beforeBuildCommand": "pnpm frontend:build --mode e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "description": "Local-only capability for the Openloop WDIO binary.",
          "local": true,
          "windows": [
            "main"
          ],
          "platforms": [
            "macOS"
          ],
          "permissions": [
            "allow-build-manifest",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true
  }
}
