{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "apps/web/tests/**/*.ts"
  ]
}
